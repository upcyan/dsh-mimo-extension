{
  "name": "dsh-mimo-usage",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "mi logo + quota ring beside the model selector, plus a MiMo usage detail tab (billing type, plan quota, per-session attribution, cost estimate).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mimo",
    "xiaomi",
    "usage",
    "billing",
    "quota"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upcyan/dsh-mimo-usage.git"
  },
  "homepage": "https://github.com/upcyan/dsh-mimo-usage#readme",
  "bugs": {
    "url": "https://github.com/upcyan/dsh-mimo-usage/issues"
  },
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./host.js": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "screenshots.json",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
